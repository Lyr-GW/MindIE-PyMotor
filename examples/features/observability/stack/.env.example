# pymotor observability stack — environment overrides
#
# Copy to `.env` and edit to taste. All values shown are defaults.

# -------- Image registry --------
# Prefix prepended to every image name. Leave empty to pull from Docker Hub.
# Example for internal Harbor: REGISTRY_PREFIX=harbor.example.com/library/
REGISTRY_PREFIX=

# -------- Image versions --------
GRAFANA_VERSION=11.3.0
PROMETHEUS_VERSION=v2.55.1
TEMPO_VERSION=2.6.1
LOKI_VERSION=3.3.0
OTEL_COLLECTOR_VERSION=0.115.1
NODE_EXPORTER_VERSION=v1.8.2
CADVISOR_VERSION=v0.49.1
NPU_EXPORTER_IMAGE=swr.cn-south-1.myhuaweicloud.com/ascendhub/npu-exporter:v6.0.0

# -------- Grafana admin --------
GF_SECURITY_ADMIN_USER=motor
GF_SECURITY_ADMIN_PASSWORD=motor

# -------- Mock exporter --------
# default | multi_pd | dsv3_ep — see mock-exporter/profiles/
MOCK_PROFILE=default
MOCK_TICK_INTERVAL_SEC=1.0

# -------- Controller metrics proxy --------
# Controller 的 /observability/metrics 返回 JSON 信封，Prometheus 无法直接抓取，
# 由 controller-metrics-proxy 解包成原生 Prometheus 文本。下方指向真实 Controller。
CONTROLLER_METRICS_URL=http://host.docker.internal:1027/observability/metrics
CONTROLLER_TIMEOUT=5
# Controller observability 端口启用 TLS 时设为 false（并在 compose 中挂载证书）。
CONTROLLER_INSECURE_SKIP_VERIFY=true

# -------- Service ports (host-side) --------
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_QUERY_PORT=3200
LOKI_PORT=3100
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8088
MOCK_EXPORTER_PORT=9105
NPU_EXPORTER_PORT=8082
CONTROLLER_PROXY_PORT=9106

# -------- Prometheus config --------
# Default: bundled example config (host.docker.internal placeholders).
# For real 2P1D deployment, copy prometheus-real-2p1d.example.yml to a local
# file, fill in your targets, and point here — do NOT commit real IP/NodePort.
PROMETHEUS_CONFIG_FILE=./prometheus/prometheus.yml

# -------- pymotor scrape targets --------
# Used by prometheus.yml as host.docker.internal fallback.
# Override with your actual coordinator / engine host:port pairs in prometheus.yml
# or via additional file_sd_configs / prometheus-real-2p1d.example.yml.
